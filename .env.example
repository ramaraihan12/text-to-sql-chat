# Read-only role the app and MCP server connect as. `sqlchat setup` creates it
# with exactly this user name and password.
DATABASE_URL=postgresql://sales_reader:sales_reader@localhost:5432/text_to_sql
# Owner account, only used by `sqlchat setup`.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/text_to_sql

# ollama (default), openai, google_genai or anthropic.
# For the paid providers install the extra (uv sync --extra openai) and set its API key,
# e.g. OPENAI_API_KEY, GOOGLE_API_KEY or ANTHROPIC_API_KEY.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434

MAX_ROWS=200
STATEMENT_TIMEOUT_MS=5000
