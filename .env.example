# Read-only role the app and MCP server connect as. `sqlchat setup` creates it
# with exactly this user name and password.
DATABASE_URL=postgresql://sales_reader:sales_reader@localhost:5432/text_to_sql
# Owner account, only used by `sqlchat setup`.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/text_to_sql
# Can only touch the daily question counter. `sqlchat setup` creates this one too.
USAGE_DATABASE_URL=postgresql://usage_counter:usage_counter@localhost:5432/text_to_sql

# ollama (default), google_genai, openai or anthropic.
# google_genai is installed by default and needs GOOGLE_API_KEY. For the other two install the
# extra (uv sync --extra openai) and set OPENAI_API_KEY or ANTHROPIC_API_KEY.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434

MAX_ROWS=200
STATEMENT_TIMEOUT_MS=5000

# Chat UI limits. The daily cap is shared by every visitor and survives restarts.
MAX_QUESTION_CHARS=300
SESSION_QUESTION_LIMIT=10
DAILY_QUESTION_LIMIT=50
